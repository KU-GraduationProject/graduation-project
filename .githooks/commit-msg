#!/bin/sh
# Python 3 is already required by this project. Never change core.hooksPath here.
root=$(git rev-parse --show-toplevel) || exit 1
# Match CI's UTF-8 mode when Windows Git Bash redirects Korean diagnostics.
export PYTHONUTF8=1
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/.github/scripts/collaboration.py" message "$1"
elif command -v python >/dev/null 2>&1; then
    exec python "$root/.github/scripts/collaboration.py" message "$1"
elif command -v py >/dev/null 2>&1; then
    exec py -3 "$root/.github/scripts/collaboration.py" message "$1"
fi
echo 'Python 3 is required. Install Python 3, then retry the commit.' >&2
exit 1
