# cp .env.example .env 후 값을 채운다. 이 파일에는 값을 넣지 않는다.
# 비워둔 선택 항목은 docker-compose.yml 의 기본값이 쓰인다.

# 필수 — 없으면 compose 가 시작을 거부한다
JWT_SECRET_KEY_DEV=        # base64, 256bit 이상
STORAGE_ACCESS_KEY=        # MinIO 루트 계정 = 앱 저장소 키
STORAGE_SECRET_KEY=        # 8자 이상

# 선택
DB_PASSWORD=
BACKEND_TAG=               # 기본 latest. 재현성을 위해 develop-<sha> 고정 권장
FRONTEND_TAG=              # 기본 latest
LEAFY_BIND_IP=             # 기본 127.0.0.1. Windows 데모: Tailscale IP
SLACK_WEBHOOK_URL=
GRAFANA_PASSWORD=
PLANT_ID_API_KEY=
OPENAI_API_KEY=
NONGSARO_API_KEY=
AIR_PURIFIY_KEY=
OPEN_WEATHER_API_KEY=
