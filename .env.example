# cp .env.example .env 후 값을 채운다. 이 파일에는 값을 넣지 않는다.
# 비워둔 선택 항목은 docker-compose.yml 의 기본값이 쓰인다.

# 필수 — 없으면 compose 가 시작을 거부한다
JWT_SECRET_KEY_DEV=        # base64, 256bit 이상
STORAGE_ACCESS_KEY=        # MinIO 루트 계정 = 앱 저장소 키
STORAGE_SECRET_KEY=        # 8자 이상

# 선택
DB_PASSWORD=
BACKEND_TAG=               # 기본 latest. 재현성을 위해 develop-<sha> 고정 권장
FRONTEND_TAG=              # 기본 latest
LEAFY_BIND_IP=             # 기본 127.0.0.1. Windows 데모: Tailscale IP
SLACK_WEBHOOK_URL=
GRAFANA_PASSWORD=
PLANT_ID_API_KEY=
OPENAI_API_KEY=
NONGSARO_API_KEY=
AIR_PURIFIY_KEY=
OPEN_WEATHER_API_KEY=

# ── AIOps 단독 배포 (docker-compose.aiops.yml) ──
# 위의 Leafy 항목은 쓰지 않는다. 아래 두 개는 필수 — 없으면 compose 가 시작을 거부한다
AIOPS_TAILSCALE_IP=        # 이 PC의 Tailscale IPv4 (tailscale ip -4). Fluentd 24224/24225를 여기에만 연다
FLUENTD_PG_SHARED_KEY=     # 24225 인증 키. 팀원 PC Fluent Bit과 같은 값. 예: openssl rand -hex 32
GRAFANA_BIND_IP=           # 기본 127.0.0.1. 팀원에게 대시보드를 보여줄 때만 Tailscale IP

# ── Remediation 인증 (Phase 0) ──
# 두 값이 없으면 해당 엔드포인트가 모든 요청을 거부한다 (조치 실행 경로이므로 fail closed).
# 실제 값은 .env 에만 두고 커밋하지 않는다.
SLACK_SIGNING_SECRET=      # SLACK_TRANSPORT=http 호환 모드에서만 /slack/action 검증에 사용
REMEDIATION_API_KEY=       # Pipeline -> Remediation /notify 및 /action HMAC 공유키. 예: openssl rand -hex 32

# ── Slack Socket Mode (기본) — docs/remote/SLACK_SOCKET_MODE.md ──
# Slack 앱에서 Socket Mode ON + connections:write App-Level Token 발급.
# 메시지는 같은 Slack 앱의 기존 SLACK_WEBHOOK_URL로 전송한다. bot token은 필요 없다.
# 토큰이 비어 있으면 Slack 수신만 not_configured; HTTP callback은 자동으로 열리지 않는다.
SLACK_TRANSPORT=socket_mode
SLACK_APP_TOKEN=
SLACK_TEAM_ID=             # 허용 workspace ID (T...)
SLACK_CHANNEL_ID=          # 지정 팀 채널 ID (C... 또는 G...). 해당 채널 구성원 누구나 승인/거부 가능
SLACK_APPROVAL_TTL_SEC=900 # 승인 요청 후 15분. 만료 시 새 요청 필요

# RCA notification-only handoff. 실제 Slack 검증 후 운영자가 명시 활성화한다.
REMEDIATION_NOTIFICATION_ENABLED=false
# RCA approval integration remains opt-in.
REMEDIATION_APPROVAL_ENABLED=false
# 노션: medium 조치(THROTTLE·KILL_SESSIONS·LOCK_ACCOUNT) 자동 실행 + 사후 알림. Pipeline·Controller 공통.
# false 면 모든 RCA 제안은 수동 승인이다. 원격 Agent 실행과 high 위험 조치는 켜도 승인이 필요하다.
REMEDIATION_AUTO_EXECUTE_ENABLED=false
REMEDIATION_PROPOSAL_MIN_CONFIDENCE=0.8
REMEDIATION_REMOTE_DEPLOYMENT_ENABLED=false
REMEDIATION_SERVICE_VERIFICATION_LOCAL_PATH=
REMEDIATION_TTL_SCAN_SEC=60
LEAFY_HEALTH_READ_TOKEN=
# 실제 대상 파일은 저장소 밖에 보관하고 절대 경로를 설정한다. 비우면 deny-all 예제 사용.
REMEDIATION_TARGET_BINDINGS_LOCAL_PATH=

# Actual DB/deployment/app executors: explicit extended override, all actions manual approval.
# Keep private verified config and API tokens outside Git. Default config targets are empty.
REMEDIATION_POSTGRES_CONFIG_LOCAL_PATH=
REMEDIATION_DEPLOYMENT_CONFIG_LOCAL_PATH=
REMEDIATION_APP_API_CONFIG_LOCAL_PATH=
REMEDIATION_EXTENDED_DOCKER_MODE=disabled
REMEDIATION_PGHOST=
REMEDIATION_PGPORT=5432
REMEDIATION_PGDATABASE=
REMEDIATION_PGUSER=
REMEDIATION_PGPASSWORD=
