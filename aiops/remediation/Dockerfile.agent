FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Agent intentionally has no Controller, Slack notifier or policy configuration.
COPY agent ./agent
COPY executor ./executor
COPY security ./security
COPY evidence.py store.py ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 AGENT_MODE=disabled
CMD ["uvicorn", "agent.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
